APP_MODE=sample
# Live mode requires all four values below. Never use an OpenAI key as the access key.
OPENAI_API_KEY=
OPENAI_MODEL=
API_ACCESS_KEY=
DATABASE_URL=postgresql://harbor:local-development-only@localhost:5433/harbor
EMBEDDING_MODEL=text-embedding-3-small
# Used for both indexed documents and query vectors; changing it requires reindexing.
TENANT_ID=harbor-demo
MAX_REQUESTS_PER_MINUTE=10

# Persistent global paid-attempt limits (UTC); 0 disables paid drafts.
MAX_LIVE_REQUESTS_PER_DAY=20
MAX_LIVE_REQUESTS_PER_MONTH=200
